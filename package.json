{
  "name": "@jakeryderv/pi-artifacts",
  "version": "0.10.0",
  "description": "Rich visualization artifacts for the Pi coding agent: scaffold, validate, and preview portable markdown and html bundles.",
  "type": "module",
  "license": "MIT",
  "author": "jakeryderv",
  "keywords": [
    "pi-package",
    "pi",
    "artifacts",
    "markdown",
    "html",
    "viewer",
    "visualization"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jakeryderv/pi-artifacts.git"
  },
  "bugs": {
    "url": "https://github.com/jakeryderv/pi-artifacts/issues"
  },
  "homepage": "https://github.com/jakeryderv/pi-artifacts#readme",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#**/node_modules\"",
    "lint:deps": "knip",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "files": [
    "demos",
    "extensions",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@picocss/pico": "^2.1.1",
    "chart.js": "^4.5.1",
    "highlight.js": "^11.11.1",
    "htmlhint": "^1.9.2",
    "katex": "^0.18.4",
    "markdown-it": "^14.3.0",
    "markdown-it-footnote": "^4.0.0",
    "markdownlint": "^0.41.1",
    "mermaid": "^11.16.1",
    "prettier": "^3.8.4"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@types/node": "^22.10.0",
    "knip": "^6.29.0",
    "markdownlint-cli2": "^0.23.2",
    "typebox": "^1.1.38",
    "typescript": "^5.9.2"
  }
}
